# Copy to .env and set your own password. .env is git-ignored.
# Standard PostgreSQL names: read by compose.yaml, the pg library and psql.
# 127.0.0.1, not localhost: the port is published on IPv4 only.
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGDATABASE=launch_rush
PGPASSWORD=change-me
# Hosted Postgres (Supabase) for the Docker deployment: set these in .env.prod (git-ignored; compose.prod.yaml reads it),
# not in .env, because the tests delete rows. Use the transaction pooler (port 6543) with the project's pooler host and user.
# PGSSLMODE=require checks the server certificate, so compose.prod.yaml also trusts certs/supabase-ca.crt.
# PGHOST=aws-0-<region>.pooler.supabase.com
# PGPORT=6543
# PGUSER=postgres.<project-ref>
# PGDATABASE=postgres
# PGSSLMODE=require

# Shared secret for the mock payment provider's webhook signatures (design §5.2). At least 32 random bytes:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
PAYMENT_WEBHOOK_SECRET=change-me

# Redis (compose.yaml publishes it on 127.0.0.1:6379). Used by the BullMQ queues.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# API server (src/api.js). API_HOST is optional: default 127.0.0.1 (this PC only); set 0.0.0.0 when hosting.
PORT=3000
# API_HOST=127.0.0.1
# TRUST_PROXY is optional: how many reverse proxies sit in front of the API (default 0). compose.prod.yaml sets 1.
# TRUST_PROXY=0
# Caddy in compose.prod.yaml: SITE_ADDRESS is the domain it gets a certificate for (set it in .env.prod, together with
# ADMIN_ORIGIN=https://<that domain>); the default is localhost.
# SITE_ADDRESS=example.com

# Optional request limits per minute: new sessions per client IP (default 10) and calls per session (default 120).
# Only the load run (tools/load) raises them; leave unset otherwise.
# RATE_LIMIT_SESSION_CREATE_PER_MIN=10
# RATE_LIMIT_SESSION_PER_MIN=120

# Optional log level (pino): fatal, error, warn, info, debug, trace or silent. Default: info.
# LOG_LEVEL=info

# Mock payment provider (sims/payment-provider). PAYMENT_PROVIDER_HOST is optional: default 127.0.0.1.
PAYMENT_PROVIDER_PORT=3001
# PAYMENT_PROVIDER_HOST=127.0.0.1
# Where the provider sends webhooks: our API's ingress (PORT above).
PAYMENT_WEBHOOK_URL=http://127.0.0.1:3000/webhooks/payment
# Where our API and worker reach the provider (its origin; PAYMENT_PROVIDER_PORT above).
PAYMENT_PROVIDER_URL=http://127.0.0.1:3001
# Bearer key for the provider's internal API, separate from PAYMENT_WEBHOOK_SECRET. At least 32 random bytes:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
PAYMENT_API_KEY=change-me

# ERP simulator (sims/erp-simulator). ERP_SIM_HOST is optional: default 127.0.0.1.
ERP_SIM_PORT=3002
# ERP_SIM_HOST=127.0.0.1
# Where our API and worker reach the simulator (its origin; ERP_SIM_PORT above).
ERP_SIM_URL=http://127.0.0.1:3002
# API key and secret, sent as "Authorization: token <key>:<secret>" like ERPNext's REST API. At least 32 random bytes each:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ERP_API_KEY=change-me
ERP_API_SECRET=change-me

# Gmail (optional until you connect it). 1. Create the separate Gmail account, 2. Google Cloud: enable the Gmail API,
# OAuth consent screen "External" with only your account as test user, then publish it to production (a "Testing" app's
# tokens expire after 7 days), 3. create an OAuth client of type "Desktop app", 4. put its id and secret and the account's
# address below, 5. run: npm run gmail-connect (prints GMAIL_REFRESH_TOKEN), 6. paste it here, restart the worker.
# Never change that account's password: Google then revokes the token and you connect again.
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_ADDRESS=
# GMAIL_REFRESH_TOKEN=

# The only origin whose pages may call the API from a browser (CORS). Optional: default http://localhost:5173 (Vite dev
# server). Set it to the portfolio's origin when hosting, e.g. https://divyanshsharma11.vercel.app
# PORTFOLIO_ORIGIN=http://localhost:5173

# Admin login (design §5.4). Optional: without these two the /admin routes are not served. Run: npm run admin-hash
# (asks for the password, prints both lines), paste them here, restart the API. ADMIN_ORIGIN is where the admin page is
# served, as browsers send it in the Origin header; default http://API_HOST:PORT. Set it when hosting.
# ADMIN_PASSWORD_HASH=
# ADMIN_PASSWORD_SALT=
# ADMIN_ORIGIN=http://127.0.0.1:3000
